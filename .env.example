# Absolute origin. OG image URLs and share links resolve against this, and a
# preview URL baked into a shared link would follow a couple around forever.
NEXT_PUBLIC_SITE_URL=https://alwayseverafter.com

# Stripe. Prices are resolved server side from these IDs; a client is never
# trusted with an amount.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_INVITATION=
NEXT_PUBLIC_STRIPE_PRICE_COMMISSION=

# The database. Supplied by the Supabase integration on Vercel; set by hand
# for local development. The service role key is server only: it bypasses row
# level security, and every table here has RLS on with no policies, so it is
# the only credential that can read or write them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Salts the hash used to count repeat form submissions. Any long random
# string. Without it the salt falls back to a known constant, and a known
# constant over the IPv4 space is brute forceable, which would make the
# privacy page's claim about this hash untrue.
RATE_LIMIT_SALT=

# Delivery of the invitation email. Without both of these the purchase still
# completes and /create still shows both links; only the email is skipped, and
# it says so.
RESEND_API_KEY=
DELIVERY_FROM=

# Who operates the service. German law (§5 DDG) requires this on every page
# that is publicly reachable, and a missing Impressum is an abmahnfähige
# offence rather than a rough edge. Kept in the environment so it is filled in
# once rather than edited into code.
#
# While any of these is unset, /impressum renders a visible warning banner.
# Publishing a silent placeholder is worse than publishing an admission that
# the page is unfinished. See docs/LESSONS.md R12.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_STREET=
NEXT_PUBLIC_OPERATOR_CITY=
NEXT_PUBLIC_OPERATOR_COUNTRY=
NEXT_PUBLIC_OPERATOR_REPRESENTED=
NEXT_PUBLIC_OPERATOR_EMAIL=
NEXT_PUBLIC_OPERATOR_PHONE=
NEXT_PUBLIC_OPERATOR_VAT_ID=
NEXT_PUBLIC_HOSTING_REGION=
